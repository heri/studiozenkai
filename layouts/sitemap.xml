{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
  xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  {{ range where .Pages "Sitemap.Disable" "ne" true }}
    {{- if and .Permalink (not (and (eq .Kind "term") (lt (len .Pages) 2))) -}}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>{{ end }}{{ if .IsTranslated }}{{ range .Translations }}
    <xhtml:link
                rel="alternate"
                hreflang="{{ .Language.LangCode }}"
                href="{{ .Permalink }}"
                />{{ end }}
    <xhtml:link
                rel="alternate"
                hreflang="{{ .Language.LangCode }}"
                href="{{ .Permalink }}"
                />{{ end }}
  </url>
    {{- end -}}
  {{ end }}
  {{- /* Standalone pages outside Hugo's content, kept in the sitemap by hand. */ -}}
  <url>
    <loc>https://studiozenkai.com/vibe-coded-to-production-ready/</loc>
    <image:image><image:loc>https://studiozenkai.com/vibe-coded-to-production-ready/og.png</image:loc></image:image>
  </url>
  <url>
    <loc>https://studiozenkai.com/kansai/</loc>
    <image:image><image:loc>https://studiozenkai.com/kansai-scroll/og.jpg</image:loc></image:image>
  </url>
  <url>
    <loc>https://studiozenkai.com/painterly/</loc>
    <image:image><image:loc>https://studiozenkai.com/painterly/og.jpg</image:loc></image:image>
  </url>
  <url>
    <loc>https://studiozenkai.com/challenge/</loc>
    <image:image><image:loc>https://studiozenkai.com/challenge/og.jpg</image:loc></image:image>
  </url>
</urlset>
